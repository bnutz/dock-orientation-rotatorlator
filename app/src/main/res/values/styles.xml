<resources>

    <!-- Compose draws everything — this is just the window frame behind it.
         (values-night switches to the dark parent.) -->
    <style name="Theme.Rotatorlator" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Launcher theme: Android 12+ system splash (icon comes from the adaptive
         launcher icon), handing off to Theme.Rotatorlator once Compose is up.
         The legacy teal keeps a cameo as the splash background. -->
    <style name="Theme.Rotatorlator.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/colorPrimary</item>
        <item name="postSplashScreenTheme">@style/Theme.Rotatorlator</item>
    </style>
</resources>
